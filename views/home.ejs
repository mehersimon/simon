<%- include('partials/head') %>

<main>
  <section class="relative overflow-hidden bg-gradient-ikat">
    <div class="max-w-6xl mx-auto px-4 py-20 sm:py-28 flex flex-col items-center text-center">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-primary-900">Discover the Beauty of Sambalpuri Sarees</h1>
      <p class="mt-4 max-w-2xl text-zinc-700 dark:text-zinc-200">Handwoven with love from the heart of Odisha — explore our exclusive collection of authentic Sambalpuri sarees.</p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a href="/find" class="rounded-lg bg-primary-700 hover:bg-primary-600 text-white px-6 py-3 shadow-lg shadow-primary-700/20 transition">Explore Sarees</a>
        <a href="/about" class="rounded-lg border border-primary-700 text-primary-800 hover:bg-primary-50 dark:hover:bg-zinc-800 px-6 py-3 transition">Learn More</a>
      </div>
    </div>
    <div class="absolute -top-10 -right-10 w-64 h-64 bg-primary-300/40 blur-3xl rounded-full animate-pulse"></div>
    <div class="absolute -bottom-10 -left-10 w-64 h-64 bg-primary-500/30 blur-3xl rounded-full animate-pulse"></div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-2xl font-bold mb-8">Featured Collections</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="bg-white dark:bg-zinc-800 rounded-xl shadow hover:shadow-glow transition p-4">
        <img class="w-full h-56 object-cover rounded-lg" src="https://img.clevup.in/38026/1688869492615_SKU-3129_0.jpg?width=600&format=webp" alt="Sambalpuri Saree 1">
        <h3 class="mt-3 text-lg font-semibold">Classic Sambalpuri</h3>
        <p class="text-sm text-zinc-600 dark:text-zinc-300">Pure cotton elegance from Western Odisha.</p>
      </div>
      <div class="bg-white dark:bg-zinc-800 rounded-xl shadow hover:shadow-glow transition p-4">
        <img class="w-full h-56 object-cover rounded-lg" src="https://www.bharatsthali.com/cdn/shop/products/final-1_4bc1c8fb-4490-4588-bf5e-f2b63c5c94fa.jpg?v=1654350697&width=1080" alt="Sambalpuri Saree 2">
        <h3 class="mt-3 text-lg font-semibold">Silk Collection</h3>
        <p class="text-sm text-zinc-600 dark:text-zinc-300">Rich silk weave with traditional ikat patterns.</p>
      </div>
      <div class="bg-white dark:bg-zinc-800 rounded-xl shadow hover:shadow-glow transition p-4">
        <img class="w-full h-56 object-cover rounded-lg" src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQuduhSgTbcLBxdJ8RCHBjg7R93ldPmC5ZgOw&s" alt="Sambalpuri Saree 3">
        <h3 class="mt-3 text-lg font-semibold">Designer Edition</h3>
        <p class="text-sm text-zinc-600 dark:text-zinc-300">Modern twist on timeless tradition.</p>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
