<%- include('partials/head') %>

<main class="max-w-6xl mx-auto px-4 py-16">
  <h1 class="text-3xl font-bold">About Sambalpuri Saree Hub</h1>
  <p class="mt-3 text-zinc-700 dark:text-zinc-200 max-w-3xl">We celebrate the heritage of Sambalpuri weaving. Our platform connects artisans with connoisseurs, ensuring authenticity, fair trade, and modern shopping experience.</p>

  <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <div class="p-6 rounded-xl bg-white dark:bg-zinc-800 shadow hover:-translate-y-1 hover:shadow-glow transition">
      <h3 class="text-xl font-semibold mb-2">Authentic Weaves</h3>
      <p class="text-zinc-600 dark:text-zinc-300">Directly from Odisha’s weaving clusters with provenance.</p>
    </div>
    <div class="p-6 rounded-xl bg-white dark:bg-zinc-800 shadow hover:-translate-y-1 hover:shadow-glow transition">
      <h3 class="text-xl font-semibold mb-2">Curated Designs</h3>
      <p class="text-zinc-600 dark:text-zinc-300">From traditional Bomkai and Pasapalli to modern twists.</p>
    </div>
    <div class="p-6 rounded-xl bg-white dark:bg-zinc-800 shadow hover:-translate-y-1 hover:shadow-glow transition">
      <h3 class="text-xl font-semibold mb-2">Fair to Artisans</h3>
      <p class="text-zinc-600 dark:text-zinc-300">Transparent pricing that values craftsmanship.</p>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
